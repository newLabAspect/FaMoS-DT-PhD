<?xml version="1.0" encoding="iso-8859-1"?>
<sspaceex xmlns="http://www-verimag.imag.fr/xml-namespaces/sspaceex" math="SpaceEx" version="0.2">
   <component id="../../../../ExampleSystems/TwoTankSubst/automata_learning_sys">
      <param controlled="true" d1="1" d2="1" dynamics="any" local="false" name="x1" type="real"/>
      <param controlled="true" d1="1" d2="1" dynamics="any" local="false" name="x2" type="real"/>
      <location id="1" name="loc1">
         <flow>x1' == 2.003 * x1 - 0.8421 * x2 - 0.1905 &amp;
 x2' == 1.201 * x1 - 0.006916 * x2 - 0.2299</flow>
      </location>
      <location id="2" name="loc2">
         <flow>x1' == 0.996 * x1 - 0.003385 * x2 + 0.006844 &amp;
 x2' == 0.004688 * x1 + 0.9832 * x2 + 0.01077</flow>
      </location>
      <transition asap="false" bezier="false" source="1" target="2" timedriven="false">
         <guard>0.0 + 1.0 &gt; 0.0</guard>
         <labelposition/>
         <middlepoint/>
      </transition>
   </component>
   <component id="../../../../ExampleSystems/TwoTankSubst/automata_learning_net">
      <param controlled="true" d1="1" d2="1" dynamics="any" local="false" name="x1" type="real"/>
      <param controlled="true" d1="1" d2="1" dynamics="any" local="false" name="x2" type="real"/>
      <bind as="../../../../ExampleSystems/TwoTankSubst/automata_learning" component="../../../../ExampleSystems/TwoTankSubst/automata_learning_sys">
         <map key="x1">x1</map>
         <map key="x2">x2</map>
      </bind>
   </component>
</sspaceex>