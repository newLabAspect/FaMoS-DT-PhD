<?xml version="1.0" encoding="iso-8859-1"?>
<sspaceex xmlns="http://www-verimag.imag.fr/xml-namespaces/sspaceex" math="SpaceEx" version="0.2">
   <component id="../../../../ExampleSystems/BouncingBall/automata_learning_sys">
      <param controlled="true" d1="1" d2="1" dynamics="any" local="false" name="x1" type="real"/>
      <param controlled="true" d1="1" d2="1" dynamics="any" local="false" name="x2" type="real"/>
      <location id="1" name="loc1">
         <flow>x1' == 0.9999 * x1 + 0.007548 * x2 + 0.00004366 &amp;
 x2' == 0.9873 * x2 - 0.02434 * x1 + 0.009623</flow>
      </location>
      <location id="2" name="loc2">
         <flow>x1' == 0.9977 * x1 + 0.006171 * x2 + 0.000924 &amp;
 x2' == 0.4968 * x2 - 0.8008 * x1 + 0.3257</flow>
      </location>
      <location id="3" name="loc3">
         <flow>x1' == 0.0 &amp;
 x2' == 0.0</flow>
      </location>
      <transition asap="false" bezier="false" source="1" target="2" timedriven="false">
         <guard>0.5573 * x2 - 56.4 * x1 + 1.0 &gt; 0.0</guard>
         <labelposition/>
         <middlepoint/>
      </transition>
      <transition asap="false" bezier="false" source="2" target="3" timedriven="false">
         <guard>-2.321 * x2 + 1.0 &gt; 0.0</guard>
         <labelposition/>
         <middlepoint/>
      </transition>
   </component>
   <component id="../../../../ExampleSystems/BouncingBall/automata_learning_net">
      <param controlled="true" d1="1" d2="1" dynamics="any" local="false" name="x1" type="real"/>
      <param controlled="true" d1="1" d2="1" dynamics="any" local="false" name="x2" type="real"/>
      <bind as="../../../../ExampleSystems/BouncingBall/automata_learning" component="../../../../ExampleSystems/BouncingBall/automata_learning_sys">
         <map key="x1">x1</map>
         <map key="x2">x2</map>
      </bind>
   </component>
</sspaceex>